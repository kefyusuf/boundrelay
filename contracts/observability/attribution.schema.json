{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundrelay.dev/schemas/m6/attribution.schema.json",
  "title": "M6 attribution block",
  "description": "Deterministic cost/latency/attribution attached to every lesson's run result. No wall-clock values, no raw payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps", "totals"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_name", "latency_ms", "cost_cents", "attempts"],
        "properties": {
          "step_name": { "type": "string", "minLength": 1 },
          "latency_ms": { "type": "integer", "minimum": 0 },
          "cost_cents": { "type": "integer", "minimum": 0 },
          "attempts": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "cost_cents", "attempts"],
      "properties": {
        "latency_ms": { "type": "integer", "minimum": 0 },
        "cost_cents": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
