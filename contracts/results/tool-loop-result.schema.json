{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundrelay.dev/contracts/results/tool-loop-result.schema.json",
  "title": "M1 Tool Loop Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "case_id",
    "mode",
    "status",
    "answer",
    "failure_code",
    "model_steps",
    "tokens_used",
    "tool_invocations",
    "trace_path"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"const": "order-investigation"},
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["direct", "agent"]},
    "status": {"type": "string", "enum": ["SUCCEEDED", "FAILED"]},
    "answer": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "failure_code": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "UNKNOWN_TOOL",
            "INVALID_TOOL_ARGUMENTS",
            "TOOL_TIMEOUT",
            "TOOL_EXECUTION_FAILED",
            "STEP_BUDGET_EXCEEDED",
            "TOKEN_BUDGET_EXCEEDED",
            "INVALID_MODEL_DECISION"
          ]
        },
        {"type": "null"}
      ]
    },
    "model_steps": {"type": "integer", "minimum": 0},
    "tokens_used": {"type": "integer", "minimum": 0},
    "tool_invocations": {"type": "integer", "minimum": 0},
    "trace_path": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "answer": {"type": "string", "minLength": 1},
          "failure_code": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "answer": {"type": "null"},
          "failure_code": {
            "type": "string",
            "enum": [
              "UNKNOWN_TOOL",
              "INVALID_TOOL_ARGUMENTS",
              "TOOL_TIMEOUT",
              "TOOL_EXECUTION_FAILED",
              "STEP_BUDGET_EXCEEDED",
              "TOKEN_BUDGET_EXCEEDED",
              "INVALID_MODEL_DECISION"
            ]
          }
        }
      }
    }
  ]
}
