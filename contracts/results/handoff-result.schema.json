{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundrelay.dev/contracts/results/handoff-result.schema.json",
  "title": "M2 Handoff Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "case_id",
    "router_mode",
    "status",
    "proposed_route",
    "selected_route",
    "receiver",
    "fallback_applied",
    "specialist_invoked",
    "failure_code",
    "trace_path"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"const": "support-handoff"},
    "case_id": {"type": "string", "minLength": 1},
    "router_mode": {"type": "string", "enum": ["code", "model"]},
    "status": {"type": "string", "enum": ["SUCCEEDED", "FAILED"]},
    "proposed_route": {
      "oneOf": [
        {"type": "string", "enum": ["billing", "technical", "general"]},
        {"type": "null"}
      ]
    },
    "selected_route": {
      "oneOf": [
        {"type": "string", "enum": ["billing", "technical", "general"]},
        {"type": "null"}
      ]
    },
    "receiver": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "billing-specialist",
            "technical-specialist",
            "general-specialist"
          ]
        },
        {"type": "null"}
      ]
    },
    "fallback_applied": {"type": "boolean"},
    "specialist_invoked": {"type": "boolean"},
    "failure_code": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INVALID_ROUTE_DECISION",
            "HANDOFF_CONTEXT_INVALID",
            "HANDOFF_RECEIVER_UNAVAILABLE"
          ]
        },
        {"type": "null"}
      ]
    },
    "trace_path": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "SUCCEEDED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "proposed_route": {"type": "string", "enum": ["billing", "technical", "general"]},
          "selected_route": {"type": "string", "enum": ["billing", "technical", "general"]},
          "receiver": {
            "type": "string",
            "enum": ["billing-specialist", "technical-specialist", "general-specialist"]
          },
          "specialist_invoked": {"const": true},
          "failure_code": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "FAILED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "specialist_invoked": {"const": false},
          "failure_code": {
            "type": "string",
            "enum": [
              "INVALID_ROUTE_DECISION",
              "HANDOFF_CONTEXT_INVALID",
              "HANDOFF_RECEIVER_UNAVAILABLE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure_code": {
            "enum": ["HANDOFF_CONTEXT_INVALID", "HANDOFF_RECEIVER_UNAVAILABLE"]
          }
        },
        "required": ["failure_code"]
      },
      "then": {
        "properties": {
          "status": {"const": "FAILED"},
          "proposed_route": {"type": "string", "enum": ["billing", "technical", "general"]},
          "selected_route": {"type": "string", "enum": ["billing", "technical", "general"]},
          "receiver": {
            "type": "string",
            "enum": ["billing-specialist", "technical-specialist", "general-specialist"]
          },
          "specialist_invoked": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {"failure_code": {"const": "INVALID_ROUTE_DECISION"}},
        "required": ["failure_code"]
      },
      "then": {
        "properties": {
          "status": {"const": "FAILED"},
          "proposed_route": {"type": "null"},
          "selected_route": {"type": "null"},
          "receiver": {"type": "null"},
          "fallback_applied": {"const": false},
          "specialist_invoked": {"const": false}
        }
      }
    }
  ]
}
