{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundrelay.dev/contracts/results/run-result.schema.json",
  "title": "M0 Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "case_id",
    "mode",
    "status",
    "selected_route",
    "specialist_invoked",
    "failure_code",
    "trace_path",
    "attribution"
  ],
  "properties": {
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "totals"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_name", "latency_ms", "cost_cents", "attempts"],
            "properties": {
              "step_name": {"type": "string", "minLength": 1},
              "latency_ms": {"type": "integer", "minimum": 0},
              "cost_cents": {"type": "integer", "minimum": 0},
              "attempts": {"type": "integer", "minimum": 1}
            }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latency_ms", "cost_cents", "attempts"],
          "properties": {
            "latency_ms": {"type": "integer", "minimum": 0},
            "cost_cents": {"type": "integer", "minimum": 0},
            "attempts": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"const": "support-triage"},
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["deterministic", "model"]},
    "status": {"type": "string", "enum": ["SUCCEEDED", "FAILED"]},
    "selected_route": {
      "oneOf": [
        {"type": "string", "enum": ["billing", "technical", "general"]},
        {"type": "null"}
      ]
    },
    "specialist_invoked": {"type": "boolean"},
    "failure_code": {
      "oneOf": [
        {"const": "INVALID_ROUTE_DECISION"},
        {"type": "null"}
      ]
    },
    "trace_path": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "SUCCEEDED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "selected_route": {"type": "string", "enum": ["billing", "technical", "general"]},
          "specialist_invoked": {"const": true},
          "failure_code": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "FAILED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "selected_route": {"type": "null"},
          "specialist_invoked": {"const": false},
          "failure_code": {"const": "INVALID_ROUTE_DECISION"}
        }
      }
    }
  ]
}
